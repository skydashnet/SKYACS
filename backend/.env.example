# miniACS Backend Configuration
# Copy this file to .env and adjust values

# Server
PORT=7547
API_PORT=7548
CWMP_BIND_ADDR=127.0.0.1
API_BIND_ADDR=127.0.0.1

# Required: generate with `openssl rand -hex 32`
JWT_SECRET=replace_with_at_least_32_random_characters
PARAMETER_ENCRYPTION_KEY=replace_with_at_least_32_random_characters

# Optional bootstrap password. If omitted, a random password is printed once.
# Must contain upper/lowercase letters and a number, minimum 12 characters.
INITIAL_ADMIN_PASSWORD=

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=miniacs
DB_USER=miniacs
DB_PASSWORD=your_secure_password
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10

# Browser origins allowed to call the API directly (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Trust forwarding headers only from these reverse-proxy addresses.
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Optional CWMP admission controls. Set username and password together.
CWMP_USERNAME=
CWMP_PASSWORD=
CWMP_ALLOWED_CIDRS=
CWMP_TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Optional but recommended: restrict ACS-initiated connection requests to CPE networks.
CONNECTION_REQUEST_ALLOWED_CIDRS=

# Firmware files are stored outside the source tree in production.
FIRMWARE_UPLOAD_DIR=./uploads/firmware
# Development only. Production firmware URLs must use HTTPS.
ALLOW_INSECURE_FIRMWARE_URL=false

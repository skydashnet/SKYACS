# miniACS Backend Configuration
# Copy this file to .env and adjust values

# Server
PORT=7547
HOST=0.0.0.0

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=miniacs
DB_USER=miniacs
DB_PASSWORD=your_secure_password

# Monitoring
MONITOR_INTERVAL_SECONDS=300
MONITOR_WORKERS=10

# Logging
LOG_LEVEL=info
